# Godot 4+ specific ignores
.godot/
.import/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Build / export output
build/
export/
*.zip
*.tar.gz

# Godot user-specific files
*.creator
*.import.bak

# Godot 에디터가 저장 중 만드는 임시 파일
*.tscn[0-9]*.tmp
*.gd[0-9]*.tmp

# MS Office (Excel/Word) 락 파일
~$*

# Python
__pycache__/
*.pyc
