[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/story_screen.gd" id="1_story"]

[node name="StoryScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_story")

[node name="CenterWrap" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Stack" type="VBoxContainer" parent="CenterWrap"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="CenterWrap/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "프롤로그"
horizontal_alignment = 1

[node name="Body" type="Label" parent="CenterWrap/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "당신은 작은 상단(商團)을 이끌고
첫 번째 마을을 향해 떠난다.
긴 여정이 시작된다."
horizontal_alignment = 1

[node name="ContinueButton" type="Button" parent="CenterWrap/Stack"]
custom_minimum_size = Vector2(220, 50)
layout_mode = 2
text = "계속"

[connection signal="pressed" from="CenterWrap/Stack/ContinueButton" to="." method="_on_continue_pressed"]
