[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/shop_screen.gd" id="1_shop"]

[node name="ShopScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="CenterWrap" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Stack" type="VBoxContainer" parent="CenterWrap"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="CenterWrap/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "상점"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CenterWrap/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "도중에 발견한 행상인"
horizontal_alignment = 1

[node name="BuyItemButton" type="Button" parent="CenterWrap/Stack"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
text = "아이템 구매 (미구현)"

[node name="BuyUnitButton" type="Button" parent="CenterWrap/Stack"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
text = "유닛 구매 (미구현)"

[node name="LeaveButton" type="Button" parent="CenterWrap/Stack"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
text = "떠나기"

[connection signal="pressed" from="CenterWrap/Stack/BuyItemButton" to="." method="_on_buy_item_pressed"]
[connection signal="pressed" from="CenterWrap/Stack/BuyUnitButton" to="." method="_on_buy_unit_pressed"]
[connection signal="pressed" from="CenterWrap/Stack/LeaveButton" to="." method="_on_leave_pressed"]
