[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/elite_screen.gd" id="1_elite"]

[node name="EliteScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_elite")

[node name="CenterWrap" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Stack" type="VBoxContainer" parent="CenterWrap"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="CenterWrap/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "엘리트 전투"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="CenterWrap/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "(강한 적 + 더 좋은 보상 — placeholder)"
horizontal_alignment = 1

[node name="VictoryButton" type="Button" parent="CenterWrap/Stack"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
text = "승리 (테스트)"

[node name="DefeatButton" type="Button" parent="CenterWrap/Stack"]
custom_minimum_size = Vector2(240, 48)
layout_mode = 2
text = "패배 (테스트)"

[connection signal="pressed" from="CenterWrap/Stack/VictoryButton" to="." method="_on_victory_pressed"]
[connection signal="pressed" from="CenterWrap/Stack/DefeatButton" to="." method="_on_defeat_pressed"]
